<domainbackup mode="push">
  <disks>
    <disk name='vda' type='file' sparsify='no'>
      <driver type='raw'/>
      <target file='/path/to/file'/>
    </disk>
    <disk name='vdb' type='file' backupmode='full' sparsify='yes'/>
    <disk name='vdc'/>
    <disk name='vdd' backup='yes' incremental='test'/>
    <disk name='hda' backup='no'/>
  </disks>
</domainbackup>
