#, c-format
msgid ""
"\n"
"Usage:\n"
"  %1$s [option]\n"
"\n"
"Options:\n"
"  -h | --help            Display program help\n"
"  -V | --version         Display program version\n"
"  -c CMD                 Run CMD via shell\n"
"\n"
"libvirt login shell\n"
msgstr ""
"\n"
"用法:\n"
"  %1$s [選項]\n"
"\n"
"選項:\n"
"  -h | --help            顯示說明\n"
"  -V | --version         顯示版本資訊\n"
"  -c CMD                 透過shell執行CMD\n"
"\n"
"libvirt 登入 shell\n"

#, c-format
msgid ""
"\n"
"Usage:\n"
"  %1$s [options]\n"
"\n"
"Options:\n"
"  -h | --help            Display program help:\n"
"  -v | --verbose         Verbose messages.\n"
"  -d | --daemon          Run as a daemon & write PID file.\n"
"  -t | --timeout <secs>  Exit after timeout period.\n"
"  -f | --config <file>   Configuration file.\n"
"  -V | --version         Display version information.\n"
"  -p | --pid-file <file> Change name of PID file.\n"
"\n"
"libvirt lock management daemon:\n"
msgstr ""
"\n"
"用法：\n"
"  %1$s [options]\n"
"\n"
"Options:\n"
"  -h | --help            顯示程式說明：\n"
"  -v | --verbose         詳細資訊。\n"
"  -d | --daemon          作為 daemon 執行並寫入 PID 檔案。\n"
"  -t | --timeout <secs>  在 timeout 時間段結束後退出。\n"
"  -f | --config <file>   組態檔。\n"
"  -V | --version         顯示版本資訊。\n"
"  -p | --pid-file <file> 更改 PID 檔名稱。\n"
"\n"
"libvirt 鎖定管理 daemon：\n"

#, c-format
msgid ""
"\n"
"Usage:\n"
