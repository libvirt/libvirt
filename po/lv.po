#, c-format
msgid ""
"\n"
"%1$s [options]... [<command_string>]\n"
"%2$s [options]... <command> [args...]\n"
"\n"
"  options:\n"
"    -c | --connect=URI      daemon admin connection URI\n"
"    -d | --debug=NUM        debug level [0-4]\n"
"    -h | --help             this help\n"
"    -l | --log=FILE         output logging to file\n"
"    -q | --quiet            quiet mode\n"
"    -v                      short version\n"
"    -V                      long version\n"
"         --version[=TYPE]   version, TYPE is short or long (default short)\n"
"  commands (non interactive mode):\n"
"\n"
msgstr ""
"\n"
"%1$s [opcijas]... [<command_string>]\n"
"%2$s [opcijas]... <command> [args...]\n"
"\n"
"  opcijas:\n"
"    -c | --connect=URI      dēmona administrēšanas savienojuma URI\n"
"    -d | --debug=NUM        atkļūdošanas līmenis [0-4]\n"
"    -h | --help             šī palīdzība\n"
"    -l | --log=FILE         izvadīt žurnalēšanu failā\n"
"    -q | --quiet            klusais režīms\n"
"    -v                      īsā versija\n"
"    -V                      garā versija\n"
"         --version[=TYPE]   versija, TYPE ir short vai long (noklusējums "
"short)\n"
"  komandas (neinteraktīvais režīms):\n"
"\n"

#, c-format
msgid ""
"\n"
"%1$s [options]... [<command_string>]\n"
"%2$s [options]... <command> [args...]\n"
"\n"
"  options:\n"
"    -c | --connect=URI      hypervisor connection URI\n"
"    -d | --debug=NUM        debug level [0-4]\n"
"    -e | --escape <char>    set escape sequence for console\n"
"    -h | --help             this help\n"
"    -k | --keepalive-interval=NUM\n"
"                            keepalive interval in seconds, 0 for disable\n"
"    -K | --keepalive-count=NUM\n"
"                            number of possible missed keepalive messages\n"
"    -l | --log=FILE         output logging to file\n"
"    -q | --quiet            quiet mode\n"
"    -r | --readonly         connect readonly\n"
"    -t | --timing           print timing information\n"
"         --no-pkttyagent    suppress registration of pkttyagent\n"
"    -v                      short version\n"
"    -V                      long version\n"
"         --version[=TYPE]   version, TYPE is short or long (default short)\n"
"  commands (non interactive mode):\n"
"\n"
msgstr ""
"\n"
"%1$s [opcijas]... [<command_string>]\n"
"%2$s [opcijas]... <command> [args...]\n"
"\n"
"  opcijas:\n"
"    -c | --connect=URI      hipervizora savienojuma URI\n"
"    -d | --debug=NUM        atkļūdošanas līmenis [0-4]\n"
"    -e | --escape <char>    iestatīt konsoles atsoļa secību\n"
"    -h | --help             šī palīdzība\n"
"    -k | --keepalive-interval=NUM\n"
"                            keepalive intervāls sekundēs, 0 — atspējot\n"
"    -K | --keepalive-count=NUM\n"
"                            iespējamo izlaisto keepalive ziņojumu skaits\n"
"    -l | --log=FILE         izvadīt žurnalēšanu failā\n"
"    -q | --quiet            klusais režīms\n"
"    -r | --readonly         savienoties tikai lasīšanai\n"
"    -t | --timing           izvadīt laika informāciju\n"
"         --no-pkttyagent    neveikt pkttyagent reģistrāciju\n"
"    -v                      īsā versija\n"
"    -V                      garā versija\n"
"         --version[=TYPE]   versija, TYPE ir short vai long (noklusējums "
"short)\n"
"  komandas (neinteraktīvais režīms):\n"
"\n"

#, c-format
msgid ""
"\n"
"%1$s mode [options] [extra file] [< def.xml]\n"
"\n"
"  Modes:\n"
"    -a | --add                     load profile\n"
"    -c | --create                  create profile from template\n"
"    -D | --delete                  unload profile and delete generated "
"rules\n"
"    -r | --replace                 reload profile\n"
"    -R | --remove                  unload profile\n"
"  Options:\n"
"    -d | --dryrun                  dry run\n"
"    -u | --uuid libvirt-<uuid>     AppArmor profile name\n"
"    -h | --help                    this help\n"
"  Extra File:\n"
"    -f | --add-file <file>         add file to a profile generated from XML\n"
"    -F | --append-file <file>      append file to an existing profile\n"
"\n"
msgstr ""
"\n"
"%1$s režīms [opcijas] [papildu fails] [< def.xml]\n"
"\n"
"  Režīmi:\n"
"    -a | --add                     ielādēt profilu\n"
"    -c | --create                  izveidot profilu no veidnes\n"
"    -D | --delete                  izlādēt profilu un dzēst ģenerētās "
"kārtulas\n"
"    -r | --replace                 pārlādēt profilu\n"
"    -R | --remove                  izlādēt profilu\n"
"  Opcijas:\n"
"    -d | --dryrun                  izmēģinājums\n"
"    -u | --uuid libvirt-<uuid>     AppArmor profila nosaukums\n"
"    -h | --help                    šī palīdzība\n"
"  Papildu fails:\n"
"    -f | --add-file <file>         pievienot failu no XML ģenerētam "
"profilam\n"
"    -F | --append-file <file>      pievienot failu esošam profilam\n"
"\n"

