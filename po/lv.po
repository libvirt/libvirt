#, c-format
msgid ""
"!!! SSH HOST KEY VERIFICATION FAILED !!!: Identity of host '%1$s:%2$d' "
"differs from stored identity. Please verify the new host key '%3$s' to avoid "
"possible man in the middle attack. The key is stored in '%4$s'."
msgstr ""
"!!! SSH RESURSDATORA ATSLĒGAS VERIFIKĀCIJA NEIZDEVĀS !!!: resursdatora „%1$s:"
"%2$d” identitāte atšķiras no saglabātās identitātes. Lūdzu, pārbaudiet jauno "
"resursdatora atslēgu „%3$s”, lai izvairītos no iespējama starpnieka "
"uzbrukuma. Atslēga ir saglabāta „%4$s”."

